{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "spot",
    "margin_mode": "",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "stake_currency": "USDT",
    "stake_amount": 50,
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,
    "timeframe": "5m",
    "fiat_display_currency": "USD",
    "cancel_open_orders_on_exit": false,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [],
        "pair_blacklist": [
            "BNB/.*"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 40,
            "sort_key": "quoteVolume",
            "refresh_period": 1800
        },
        {
            "method": "IslamicComplianceFilter",
            "audit_mode": false,
            "blacklist": [],
            "allowlist": []
        },
        {
            "method": "AgeFilter",
            "min_days_listed": 10
        },
        {
            "method": "PriceFilter",
            "min_price": 0.001
        }
    ],
    "protections": [
        {
            "method": "MaxDailyLoss",
            "max_allowed_loss": 0.05
        },
        {
            "method": "MaxWeeklyLoss",
            "max_allowed_loss": 0.1
        },
        {
            "method": "MaxDrawdown",
            "lookback_period_candles": 48,
            "trade_limit": 5,
            "stop_duration_candles": 12,
            "max_allowed_drawdown": 0.1
        },
        {
            "method": "StoplossGuard",
            "lookback_period_candles": 24,
            "trade_limit": 4,
            "stop_duration_candles": 12,
            "only_per_pair": false
        },
        {
            "method": "CooldownPeriod",
            "stop_duration_candles": 2
        }
    ],
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "internals": {
        "process_throttle_secs": 5
    }
}
