# Copy to deploy/.env, chmod 600. Never commit the copy.
DOMAIN=quant.example.com
POSTGRES_PASSWORD=change-me
QL_DATABASE_URL=postgresql+psycopg://quantlab:change-me@postgres:5432/quantlab
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Also derives the key encrypting API secrets: losing it makes stored keys unreadable.
QL_SECRET_KEY=
# Used once, to create the owner on first start. Remove afterwards.
QL_OWNER_PASSWORD=
QL_SECURE_COOKIES=true
QL_BINANCE_PUBLIC_URL=https://data-api.binance.vision
QL_BINANCE_WS_URL=wss://data-stream.binance.vision/stream
# Master switch for real orders. Stays false until after the evaluation and your approval.
QL_LIVE_ENABLED=false
# Optional. The web app works fully without Telegram.
QL_TELEGRAM_TOKEN=
QL_TELEGRAM_CHAT_ID=

# Optional AI research. Off until switched on in the web app. The API key stays on the server.
# QL_AI_API_KEY=
# QL_AI_MODEL=claude-opus-5-5
# QL_AI_MAX_TOKENS=8000
# QL_AI_TIMEOUT_S=120
# QL_AI_DAILY_CALLS=5
# QL_AI_DAILY_USD=1.0
# Interpreter of a separate venv holding TradingAgents and its own LLM keys.
# QL_TRADINGAGENTS_PYTHON=
