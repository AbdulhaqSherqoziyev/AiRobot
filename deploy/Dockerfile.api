# API and all workers (one image, different commands). Python 3.13 per the repo audit.
FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY quantlab/requirements.txt quantlab-requirements.txt
RUN pip install --no-cache-dir -r quantlab-requirements.txt
# CPU build, for the LSTM models
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
# Only the screening helper is used from Freqtrade, loaded by file path.
COPY quantlab quantlab
# Both off by default. VectorBT adds about 800 MB to the image and needs several GB of memory on
# large sweeps; sweeps run on the native engine without it. The AI SDK is needed only for Claude reports.
ARG INSTALL_VECTORBT=0
ARG INSTALL_AI=0
RUN if [ "$INSTALL_VECTORBT" = "1" ]; then pip install --no-cache-dir -r quantlab/requirements-research.txt; fi
RUN if [ "$INSTALL_AI" = "1" ]; then pip install --no-cache-dir -r quantlab/requirements-ai.txt; fi
COPY freqtrade/islamic/screening.py freqtrade/islamic/screening.py
RUN useradd -m -u 1000 app && mkdir -p /data && chown app /data
USER app
ENV QL_DATA_DIR=/data PYTHONUNBUFFERED=1
